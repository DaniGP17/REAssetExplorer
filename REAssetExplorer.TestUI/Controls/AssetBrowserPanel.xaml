<UserControl x:Class="REAssetExplorer.TestUI.Controls.AssetBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:REAssetExplorer.TestUI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="1100">

    <UserControl.Resources>

        <!-- Folder tree item container -->
        <Style x:Key="PakFolderItemStyle" TargetType="TreeViewItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" Background="Transparent" Height="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="Exp" Grid.Column="0"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Visibility="Collapsed" Focusable="False">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <Path x:Name="Arr" Fill="#606060"
                                                          Data="M 3 2 L 9 7 L 3 12 Z"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arr" Property="Data"  Value="M 1 3 L 9 3 L 5 9 Z"/>
                                                        <Setter TargetName="Arr" Property="Fill"  Value="#aaaaaa"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Arr" Property="Fill"  Value="#eeeeee"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" Margin="14,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems"   Value="True">
                                <Setter TargetName="Exp"       Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd"        Property="Background" Value="#1e3a50"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid column header -->
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="#1a1a1a"/>
            <Setter Property="Foreground"   Value="#666666"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontFamily"   Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
            <Setter Property="Padding"      Value="8,4"/>
            <Setter Property="BorderBrush"  Value="#2a2a2a"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="SeparatorBrush"  Value="#2a2a2a"/>
        </Style>

        <!-- DataGrid row -->
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height"     Value="24"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1e3a50"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsSelected"  Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#252525"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid cell -->
        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="FocusVisualStyle"        Value="{x:Null}"/>
            <Setter Property="Foreground"              Value="#c0c0c0"/>
            <Setter Property="FontSize"                Value="12"/>
            <Setter Property="FontFamily"              Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
            <Setter Property="Padding"                 Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground"  Value="#ffffff"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <DockPanel Background="#202020">

        <!-- ── Path bar ── -->
        <Border DockPanel.Dock="Top" Height="30" Background="#181818"
                BorderBrush="#2a2a2a" BorderThickness="0,0,0,1">
            <DockPanel Margin="4,0" VerticalAlignment="Stretch">

                <Button Style="{StaticResource AssetNavButtonStyle}"
                        Content="←" FontSize="14" ToolTip="Back"
                        Click="OnBack"/>
                <Button Style="{StaticResource AssetNavButtonStyle}"
                        Content="→" FontSize="14" ToolTip="Forward"
                        Click="OnForward" Margin="2,0,0,0"/>
                <Button Style="{StaticResource AssetNavButtonStyle}"
                        Content="↑" FontSize="14" ToolTip="Up"
                        Click="OnUp" Margin="2,0,6,0"/>

                <Border BorderBrush="#3a3a3a" BorderThickness="1"
                        VerticalAlignment="Stretch" Margin="0,3,0,3">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center" Padding="4,0">
                        <ItemsControl x:Name="BreadcrumbBar">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BreadcrumbButtonStyle}"
                                                Tag="{Binding TreeItemRef}"
                                                Click="OnBreadcrumbClick">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </Button>
                                        <Image Source="../Assets/img/start.png"
                                               Width="8" Margin="2,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding SeparatorVisibility}"
                                               IsHitTestVisible="False"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

            </DockPanel>
        </Border>

        <!-- ── Body: folder tree (left) + file grid (right) ── -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="80"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="80"/>
            </Grid.ColumnDefinitions>

            <!-- ── Tab buttons (col 0, row 0) ── -->
            <StackPanel Grid.Row="0" Grid.Column="0"
                        Orientation="Horizontal"
                        Background="#181818">
                <StackPanel.Resources>
                    <Style x:Key="AssetTabStyle" TargetType="ToggleButton">
                        <Setter Property="Background"       Value="Transparent"/>
                        <Setter Property="BorderThickness"  Value="0,0,0,2"/>
                        <Setter Property="BorderBrush"      Value="Transparent"/>
                        <Setter Property="Foreground"       Value="#808080"/>
                        <Setter Property="FontSize"         Value="12"/>
                        <Setter Property="FontFamily"       Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
                        <Setter Property="Padding"          Value="12,5"/>
                        <Setter Property="Cursor"           Value="Hand"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bg"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#222222"/>
                                            <Setter Property="Foreground" Value="#b0b0b0"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bg" Property="BorderBrush" Value="#4a87c8"/>
                                            <Setter Property="Foreground" Value="#e0e0e0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>
                <ToggleButton Style="{StaticResource AssetTabStyle}" Content="Assets"
                              IsChecked="True" Margin="5,0,2,0"/>
                <ToggleButton Style="{StaticResource AssetTabStyle}" Content="Favorites"/>
            </StackPanel>

            <!-- ── Search bar (col 2, row 0) ── -->
            <Grid Grid.Row="0" Grid.Column="2" Background="#181818">
                <Image Style="{StaticResource ToolbarIconStyle}" Width="12"
                       Source="../Assets/img/search.png"
                       HorizontalAlignment="Left" Margin="7,0,0,0"/>
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource HierarchySearchBoxStyle}"
                         Padding="26,0,0,0"
                         VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                         KeyDown="OnSearchKeyDown"
                         TextChanged="OnSearchTextChanged"/>
            </Grid>

            <!-- Splitter spans both rows -->
            <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#252525"/>

            <!-- ── Folder tree ── -->
            <TreeView Grid.Row="1" Grid.Column="0"
                      x:Name="FolderTree"
                      Background="#1e1e1e"
                      BorderThickness="0"
                      Padding="0,4"
                      ItemContainerStyle="{StaticResource PakFolderItemStyle}"
                      SelectedItemChanged="OnTreeFolderSelected"
                      VirtualizingStackPanel.IsVirtualizing="True">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding FolderChildren}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="../Assets/img/folder.png"
                                   Width="12" Margin="0,0,5,0"
                                   VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}"
                                       Foreground="#b8b8b8" FontSize="12"
                                       VerticalAlignment="Center"
                                       FontFamily="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- ── File DataGrid ── -->
            <DataGrid Grid.Row="1" Grid.Column="2"
                      x:Name="FileGrid"
                      Background="#1e1e1e"
                      Foreground="#c0c0c0"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#252525"
                      RowBackground="Transparent"
                      AlternatingRowBackground="Transparent"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                      RowStyle="{StaticResource GridRowStyle}"
                      CellStyle="{StaticResource GridCellStyle}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Export Raw"              Click="OnExportRaw"/>
                        <MenuItem Header="Extract (Decompressed)"  Click="OnExtractDecompressed"/>
                        <Separator/>
                        <MenuItem Header="Copy Name"               Click="OnCopyName"/>
                        <MenuItem Header="Open File Location"
                                  x:Name="OpenLocationMenuItem"
                                  Click="OnOpenFileLocation"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>

                    <!-- Name with type badge -->
                    <DataGridTemplateColumn Header="NAME" Width="2*" MinWidth="200"
                                            SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                    <Border Background="#181818"
                                            BorderBrush="{Binding TagColor}"
                                            BorderThickness="1"
                                            Width="32" Height="16" CornerRadius="2"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ExtTag}"
                                                   Foreground="{Binding TagColor}"
                                                   FontSize="9" FontWeight="Bold"
                                                   FontFamily="Consolas"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#c8c8c8" FontSize="12"
                                               VerticalAlignment="Center"
                                               FontFamily="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="TYPE"        Binding="{Binding Type}"           Width="*"  MinWidth="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin"            Value="8,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="SIZE"        Binding="{Binding Size}"            Width="*"  MinWidth="70"  SortMemberPath="SizeBytes">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin"            Value="8,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="COMPRESSED"  Binding="{Binding CompressedSize}"  Width="*"  MinWidth="90"  SortMemberPath="CompressedSizeBytes">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin"            Value="8,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="COMPRESSION" Binding="{Binding Compression}"     Width="*"  MinWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin"            Value="8,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </DockPanel>
</UserControl>
