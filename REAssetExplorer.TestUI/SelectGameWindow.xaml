<Window x:Class="REAssetExplorer.TestUI.SelectGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="REAssetExplorer"
        Width="460" Height="560"
        MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="pack://application:,,,/Assets/fonts/#DIN Alternate">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Game row: RadioButton custom -->
        <Style x:Key="GameRowStyle" TargetType="RadioButton">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="row"
                                Background="#1e1e1e"
                                BorderBrush="#2a2a2a"
                                BorderThickness="0,0,0,1"
                                Padding="0">
                            <Grid Height="58">
                                <!-- Left accent bar -->
                                <Border x:Name="accent"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource AccentBrush}"
                                        Visibility="Collapsed"/>

                                <!-- Content -->
                                <DockPanel Margin="16,0,16,0" LastChildFill="True">
                                    <!-- Badge -->
                                    <Border x:Name="badge"
                                            DockPanel.Dock="Left"
                                            Width="38" Height="28"
                                            CornerRadius="3"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center"
                                            Background="#2a2a2a">
                                        <TextBlock Text="{Binding ShortId}"
                                                   Foreground="White"
                                                   FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name + subtitle -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="gameName"
                                                   Text="{Binding Name}"
                                                   Foreground="#c8c8c8"
                                                   FontSize="14"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Foreground="#666666"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row"      Property="Background" Value="#252525"/>
                                <Setter TargetName="gameName" Property="Foreground" Value="#e0e0e0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="row"    Property="Background"        Value="#272727"/>
                                <Setter TargetName="accent" Property="Visibility"        Value="Visible"/>
                                <Setter TargetName="gameName" Property="Foreground"      Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón primario (CONTINUE) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Padding"         Value="24,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#ff3a3d"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#c01e20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#3a3a3a"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario (Help, Browse) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#2a2a2a"/>
            <Setter Property="Foreground"      Value="#a0a0a0"/>
            <Setter Property="BorderBrush"     Value="#3a3a3a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="14,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"   Value="#333333"/>
                                <Setter TargetName="bg" Property="BorderBrush"  Value="#4a4a4a"/>
                                <Setter Property="Foreground" Value="#c0c0c0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox oscuro para path -->
        <Style x:Key="PathBoxStyle" TargetType="TextBox">
            <Setter Property="Background"            Value="#1a1a1a"/>
            <Setter Property="Foreground"            Value="#a0a0a0"/>
            <Setter Property="BorderBrush"           Value="#3a3a3a"/>
            <Setter Property="BorderThickness"       Value="1"/>
            <Setter Property="FontSize"              Value="12"/>
            <Setter Property="Padding"               Value="8,0"/>
            <Setter Property="VerticalAlignment"     Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"            Value="#c0c0c0"/>
            <Setter Property="FontFamily"            Value="Consolas"/>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- ── Barra de título ── -->
        <Grid DockPanel.Dock="Top" Height="30" Background="{StaticResource BgMenuBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1"
                       Text="REAssetExplorer  -  Select Game"
                       Foreground="#606060"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="10,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE921;"
                        ToolTip="Minimizar"
                        Click="OnMinimize"/>
                <Button Style="{StaticResource CloseButtonStyle}"
                        Content="&#xE8BB;"
                        ToolTip="Cerrar"
                        Click="OnClose"/>
            </StackPanel>
        </Grid>

        <!-- ── Separador ── -->
        <Border DockPanel.Dock="Top" Height="1" Background="#2a2a2a"/>

        <!-- ── Header: logo + nombre ── -->
        <Border DockPanel.Dock="Top" Background="#181818" Padding="28,20,28,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="46" Height="46" CornerRadius="4"
                        Background="#111111"
                        BorderBrush="#333333" BorderThickness="1"
                        Margin="0,0,14,0">
                    <Image Source="Assets/img/re_engine.jpg"
                           Width="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="REAssetExplorer"
                               FontSize="20"
                               Foreground="#dddddd"/>
                    <TextBlock Text="Select a game to get started"
                               FontSize="12"
                               Foreground="#666666"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Footer ── -->
        <Border DockPanel.Dock="Bottom" Background="#181818"
                BorderBrush="#2a2a2a" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Help"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnHelp"/>

                <Button Grid.Column="2"
                        x:Name="ContinueButton"
                        Content="CONTINUE"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False"
                        Click="OnContinue"/>
            </Grid>
        </Border>

        <!-- ── Cuerpo ── -->
        <DockPanel Margin="24,20">

            <!-- Sección: directorio del juego -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                <TextBlock Text="GAME DIRECTORY"
                           Foreground="#555555"
                           FontSize="10"
                               Margin="0,0,0,8"/>

                <Border Background="#1a1a1a"
                        BorderBrush="#333333" BorderThickness="1"
                        CornerRadius="2" Height="32">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,0"
                                Margin="0" Height="32"
                                BorderThickness="1,0,0,0"
                                Click="OnBrowse">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Assets/img/folder.png" Width="14" Margin="0,0,5,0"/>
                                <TextBlock Text="Browse" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBox x:Name="GamePathBox"
                                 Style="{StaticResource PathBoxStyle}"
                                 Text="Select or paste the game installation folder..."
                                 Foreground="#444444"
                                 GotFocus="OnPathBoxGotFocus"
                                 TextChanged="OnPathChanged"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Sección: lista de juegos -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="SELECT A GAME"
                           Foreground="#555555"
                           FontSize="10"
                               Margin="0,0,0,8"/>

                <Border Background="#1a1a1a"
                        BorderBrush="#2a2a2a" BorderThickness="1"
                        CornerRadius="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="GameList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource GameRowStyle}"
                                                 GroupName="Games"
                                                 Checked="OnGameChecked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>

        </DockPanel>

    </DockPanel>
</Window>
