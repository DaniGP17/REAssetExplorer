<Window x:Class="REAssetExplorer.TestUI.BankViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Audio Bank Viewer"
        Width="1100" Height="720"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="pack://application:,,,/Assets/fonts/#DIN Alternate">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#8a8a8a"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Margin"     Value="0,0,0,14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
        </Style>

        <!-- Transport / icon button -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width"      Value="36"/>
            <Setter Property="Height"     Value="36"/>
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#c8c8c8"/>
            <Setter Property="BorderBrush" Value="#3a3a3a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#323232"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#4a87c8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1e3a50"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5a5a5a"/>
                                <Setter TargetName="bg" Property="Background" Value="#1a1a1a"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#2a2a2a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#4a87c8"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#3a6fa8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="14,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#5d99d9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3a6fa8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#2a2a2a"/>
                                <Setter Property="Foreground"                  Value="#666666"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#2a2a2a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider thumb/track -->
        <Style x:Key="AudioSliderStyle" TargetType="Slider">
            <Setter Property="MinHeight" Value="20"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="3" Background="#2a2a2a" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" Background="#4a87c8" CornerRadius="2" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="#e8e8e8" Stroke="#4a87c8" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ── Title bar ── -->
        <Grid DockPanel.Dock="Top" Height="30" Background="{StaticResource BgMenuBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="TitleText"
                       Text="Audio Bank Viewer"
                       Foreground="#a0a0a0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="14,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" ToolTip="Minimize"  Click="OnMinimize"/>
                <Button x:Name="MaxRestoreButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" ToolTip="Maximize" Click="OnMaxRestore"/>
                <Button Style="{StaticResource CloseButtonStyle}"   Content="&#xE8BB;" ToolTip="Close"     Click="OnClose"/>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Height="1" Background="#2a2a2a"/>

        <!-- ── Status bar ── -->
        <Border DockPanel.Dock="Bottom"
                Background="#1a1a1a"
                BorderBrush="#2a2a2a" BorderThickness="0,1,0,0"
                Padding="10,5">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       FontSize="12"
                       Foreground="#9f9f9f"/>
        </Border>

        <!-- ── Main split: file list + player (left) | info (right) ── -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"   MinWidth="380"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="240" MaxWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: audio files + transport ── -->
            <Border Grid.Column="0"
                    Background="#181818"
                    BorderBrush="#2a2a2a"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Audio list -->
                    <Grid Grid.Row="0">
                        <DataGrid x:Name="AudioFilesGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#252525"
                                  Background="#1e1e1e"
                                  Foreground="#c8c8c8"
                                  BorderThickness="0"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="Transparent"
                                  SelectionChanged="OnAudioSelectionChanged"
                                  MouseDoubleClick="OnAudioGridDoubleClick"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"        Binding="{Binding Index,            Mode=OneWay}" Width="50"/>
                                <DataGridTextColumn Header="ID"       Binding="{Binding Id,               Mode=OneWay}" Width="100"/>
                                <DataGridTextColumn Header="NAME"     Binding="{Binding Name,             Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="SIZE"     Binding="{Binding SizeFormatted,    Mode=OneWay}" Width="80"/>
                                <DataGridTextColumn Header="DURATION" Binding="{Binding DurationFormatted,Mode=OneWay}" Width="80"/>
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1a1a1a"/>
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Setter Property="FontSize"   Value="11"/>
                                    <Setter Property="Padding"    Value="8,4"/>
                                    <Setter Property="BorderBrush" Value="#2a2a2a"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="SeparatorBrush"  Value="#2a2a2a"/>
                                    <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background"      Value="Transparent"/>
                                    <Setter Property="Height"          Value="24"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1e3a50"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected"  Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#252525"/>
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness"          Value="0"/>
                                    <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
                                    <Setter Property="Foreground"               Value="#c0c0c0"/>
                                    <Setter Property="FontSize"                 Value="12"/>
                                    <Setter Property="FontFamily"               Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
                                    <Setter Property="Padding"                  Value="8,0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background"  Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Foreground"  Value="#ffffff"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Play"             Click="OnPlaySelected"/>
                                    <MenuItem Header="Export as WEM"    Click="OnExportWem"/>
                                    <MenuItem Header="Export as OGG"    Click="OnExportOgg"/>
                                    <Separator/>
                                    <MenuItem Header="Export All as WEM" Click="OnExportAllWem"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>

                        <!-- Empty / loading overlays -->
                        <Border x:Name="LoadingOverlay"
                                Visibility="Collapsed"
                                Background="#cc101010">
                            <TextBlock x:Name="LoadingText"
                                       Text="Loading…"
                                       Foreground="#c8c8c8"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="ErrorOverlay"
                                Visibility="Collapsed"
                                Background="#cc1a0a0a">
                            <TextBlock x:Name="ErrorText"
                                       Foreground="#ff6868"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="30"/>
                        </Border>
                    </Grid>

                    <!-- Player / transport panel -->
                    <Border Grid.Row="1"
                            Background="#1e1e1e"
                            BorderBrush="#2a2a2a"
                            BorderThickness="0,1,0,0"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Now playing -->
                            <TextBlock x:Name="NowPlayingText"
                                       Grid.Row="0"
                                       Text="No audio selected"
                                       FontSize="13"
                                       Foreground="#e0e0e0"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,10"/>

                            <!-- Progress bar with times -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CurrentTimeText"
                                           Grid.Column="0"
                                           Text="00:00"
                                           FontSize="11"
                                           Foreground="#909090"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           MinWidth="40"/>
                                <Slider x:Name="ProgressSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource AudioSliderStyle}"
                                        Minimum="0" Maximum="100" Value="0"
                                        VerticalAlignment="Center"
                                        PreviewMouseDown="OnProgressMouseDown"
                                        PreviewMouseUp="OnProgressMouseUp"
                                        ValueChanged="OnProgressValueChanged"/>
                                <TextBlock x:Name="TotalTimeText"
                                           Grid.Column="2"
                                           Text="00:00"
                                           FontSize="11"
                                           Foreground="#909090"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           MinWidth="40"/>
                            </Grid>

                            <!-- Transport controls -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: transport buttons -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button x:Name="PrevButton"      Style="{StaticResource IconButtonStyle}" Content="&#xE100;" ToolTip="Previous"  Margin="0,0,4,0" Click="OnPrev"/>
                                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButtonStyle}" Content="&#xE768;" ToolTip="Play/Pause" Margin="0,0,4,0" Click="OnPlayPause"/>
                                    <Button x:Name="StopButton"      Style="{StaticResource IconButtonStyle}" Content="&#xE71A;" ToolTip="Stop"      Margin="0,0,4,0" Click="OnStop"/>
                                    <Button x:Name="NextButton"      Style="{StaticResource IconButtonStyle}" Content="&#xE101;" ToolTip="Next"      Click="OnNext"/>
                                </StackPanel>

                                <!-- Center: volume -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE767;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Foreground="#909090"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Slider x:Name="VolumeSlider"
                                            Style="{StaticResource AudioSliderStyle}"
                                            Width="120" Minimum="0" Maximum="100" Value="50"
                                            VerticalAlignment="Center"
                                            ValueChanged="OnVolumeChanged"
                                            ToolTip="Volume"/>
                                    <TextBlock x:Name="VolumeText"
                                               Text="50%"
                                               FontSize="11"
                                               Foreground="#909090"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               MinWidth="36"/>
                                </StackPanel>

                                <!-- Right: export -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="ExportButton"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Export"
                                            Padding="14,0"
                                            Height="36"
                                            Click="OnExportDropdown">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Export as WEM"     Click="OnExportWem"/>
                                                <MenuItem Header="Export as OGG"     Click="OnExportOgg"/>
                                                <Separator/>
                                                <MenuItem Header="Export All as WEM" Click="OnExportAllWem"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#252525"/>

            <!-- ── Right: bank info ── -->
            <Border Grid.Column="2"
                    Background="#1e1e1e"
                    BorderBrush="#2a2a2a"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Bank Information"
                                   FontSize="15"
                                   Foreground="#e8e8e8"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="File Name"     Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="FileNameText" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock Text="Full Path"     Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="FilePathText" Style="{StaticResource InfoValueStyle}"
                                   Foreground="#909090" FontSize="11"/>

                        <TextBlock Text="Bank ID"       Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="BankIdText"   Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock Text="Version"       Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="VersionText"  Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock Text="Language"      Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="LanguageText" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock Text="Project ID"    Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="ProjectIdText" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock Text="Audio Files"   Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="AudioCountText" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock Text="Total WEM Size" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="TotalSizeText" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock Text="HIRC Objects"  Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="HircText"     Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock Text="String Table"  Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="StringTableText" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock Text="Codebooks"     Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock x:Name="CodebooksText" Style="{StaticResource InfoValueStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </DockPanel>
</Window>
