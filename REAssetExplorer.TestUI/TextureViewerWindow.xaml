<Window x:Class="REAssetExplorer.TestUI.TextureViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Texture Viewer"
        Width="1100" Height="720"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="pack://application:,,,/Assets/fonts/#DIN Alternate">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Tiny info label (key) -->
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#8a8a8a"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
        </Style>

        <!-- Info value -->
        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="#dddddd"/>
            <Setter Property="Margin"     Value="0,0,0,14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
        </Style>

        <!-- Icon button (zoom controls) -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width"      Value="32"/>
            <Setter Property="Height"     Value="32"/>
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#c8c8c8"/>
            <Setter Property="BorderBrush" Value="#3a3a3a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#323232"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#4a87c8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1e3a50"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5a5a5a"/>
                                <Setter TargetName="bg" Property="Background" Value="#1a1a1a"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#2a2a2a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button (Export) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#4a87c8"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#3a6fa8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="14,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#5d99d9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3a6fa8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#2a2a2a"/>
                                <Setter Property="Foreground"                  Value="#666666"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#2a2a2a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ── Title bar ── -->
        <Grid DockPanel.Dock="Top" Height="30" Background="{StaticResource BgMenuBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="TitleText"
                       Text="Texture Viewer"
                       Foreground="#a0a0a0"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="14,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" ToolTip="Minimize"  Click="OnMinimize"/>
                <Button x:Name="MaxRestoreButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" ToolTip="Maximize" Click="OnMaxRestore"/>
                <Button Style="{StaticResource CloseButtonStyle}"   Content="&#xE8BB;" ToolTip="Close"     Click="OnClose"/>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Height="1" Background="#2a2a2a"/>

        <!-- ── Status bar ── -->
        <Border DockPanel.Dock="Bottom" Background="#1a1a1a"
                BorderBrush="#2a2a2a" BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       FontSize="12"
                       Foreground="#9f9f9f"/>
        </Border>

        <!-- ── Main content: preview (left) + info (right) ── -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"      MinWidth="320"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320"    MinWidth="240" MaxWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- ── Preview area ── -->
            <Border Grid.Column="0"
                    Background="#181818"
                    BorderBrush="#2a2a2a"
                    BorderThickness="1">
                <Grid>
                    <!-- Checkerboard (visible only when alpha is shown) -->
                    <Rectangle x:Name="CheckerboardBackground" Visibility="Collapsed">
                        <Rectangle.Fill>
                            <DrawingBrush Viewport="0,0,20,20"
                                          ViewportUnits="Absolute"
                                          TileMode="Tile">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#2a2a2a">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="0,0,10,10"/>
                                                    <RectangleGeometry Rect="10,10,10,10"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#1a1a1a">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="10,0,10,10"/>
                                                    <RectangleGeometry Rect="0,10,10,10"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <ScrollViewer x:Name="ImageScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="ImageScaleTransform"
                                                ScaleX="1" ScaleY="1"/>
                            </Grid.LayoutTransform>

                            <Image x:Name="TextureImage"
                                   Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Grid>
                    </ScrollViewer>

                    <!-- Loading / error overlay -->
                    <Border x:Name="LoadingOverlay"
                            Visibility="Collapsed"
                            Background="#cc101010">
                        <TextBlock x:Name="LoadingText"
                                   Text="Loading…"
                                   Foreground="#c8c8c8"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="ErrorOverlay"
                            Visibility="Collapsed"
                            Background="#cc1a0a0a">
                        <TextBlock x:Name="ErrorText"
                                   Foreground="#ff6868"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="30"/>
                    </Border>

                    <!-- Zoom + fit controls -->
                    <Border Background="#cc1e1e1e"
                            BorderBrush="#3a3a3a" BorderThickness="1"
                            CornerRadius="3"
                            Padding="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Content="&#xE71F;" ToolTip="Zoom out"
                                    Margin="0,0,4,0" Click="OnZoomOut"/>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Content="&#xE9A6;" ToolTip="Fit to window"
                                    Margin="0,0,4,0" Click="OnZoomFit"/>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Content="&#xE71E;" ToolTip="Zoom in"
                                    Margin="0,0,4,0" Click="OnZoomIn"/>
                            <Border Background="#252525" BorderBrush="#3a3a3a" BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="6,0"
                                    VerticalAlignment="Stretch">
                                <TextBlock x:Name="ZoomText"
                                           Text="100%"
                                           FontSize="12"
                                           Foreground="#c8c8c8"
                                           VerticalAlignment="Center"
                                           MinWidth="50"
                                           TextAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#252525"/>

            <!-- ── Info panel ── -->
            <Border Grid.Column="2"
                    Background="#1e1e1e"
                    BorderBrush="#2a2a2a"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>

                            <TextBlock Text="Texture Information"
                                       FontSize="15"
                                       Foreground="#e8e8e8"
                                       Margin="0,0,0,18"/>

                            <TextBlock Text="File Name"      Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock x:Name="FileNameText" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Text="Full Path"      Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock x:Name="FilePathText" Style="{StaticResource InfoValueStyle}"
                                       Foreground="#909090" FontSize="11"/>

                            <TextBlock Text="Dimensions"     Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock x:Name="DimensionsText" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Text="Format"         Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock x:Name="FormatText"   Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Text="Mipmap Levels"  Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock x:Name="MipmapText"   Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Text="View Mipmap"    Style="{StaticResource InfoLabelStyle}"/>
                            <ComboBox  x:Name="MipmapSelector"
                                       Style="{StaticResource DarkComboBoxStyle}"
                                       ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"
                                       Height="26"
                                       Margin="0,0,0,14"
                                       SelectionChanged="OnMipmapChanged"/>

                            <TextBlock Text="Images / Type"  Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock x:Name="ImagesText"   Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Text="Alpha Channel"  Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock x:Name="AlphaText"    Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Text="Data Size"      Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock x:Name="DataSizeText" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Text="Compression"    Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock x:Name="CompressionText" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Text="Streaming Flags" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock x:Name="StreamingText" Style="{StaticResource InfoValueStyle}"/>

                            <TextBlock Text="Version"        Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock x:Name="VersionText"  Style="{StaticResource InfoValueStyle}"/>

                            <!-- Alpha toggle button -->
                            <TextBlock Text="Show Alpha Channel" Style="{StaticResource InfoLabelStyle}"/>
                            <Button x:Name="AlphaToggleButton"
                                    Style="{StaticResource IconButtonStyle}"
                                    Content="Off"
                                    FontFamily="pack://application:,,,/Assets/fonts/#DIN Alternate"
                                    FontSize="11"
                                    Width="80" Height="26"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,14"
                                    Click="OnAlphaToggle"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Export button row -->
                    <Grid Grid.Row="1"
                          Background="#181818"
                          Margin="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Background="#2a2a2a"/>

                        <Button x:Name="ExportButton"
                                Grid.Column="0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Export PNG"
                                Margin="10,10,4,10"
                                Click="OnExportPng"/>
                        <Button x:Name="ExportDropdownButton"
                                Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="&#xE70D;"
                                FontFamily="Segoe MDL2 Assets" FontSize="10"
                                MinWidth="36"
                                Margin="0,10,10,10"
                                Padding="0"
                                ToolTip="More export formats"
                                Click="OnExportDropdown">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ExportContextMenu" Placement="Top">
                                    <MenuItem Header="PNG" Click="OnExportPng"/>
                                    <MenuItem Header="DDS" Click="OnExportDds"/>
                                    <MenuItem Header="TGA" Click="OnExportTga"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

    </DockPanel>
</Window>
