<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:REAssetExplorer.TestUI">

    <!-- ── Palette ── -->
    <Color x:Key="BgDeepColor">#FF1A1A1A</Color>
    <Color x:Key="BgPanelColor">#FF242424</Color>
    <Color x:Key="BgMenuColor">#181818</Color>
    <Color x:Key="BgMenuItemHoverColor">#FF3D3D3D</Color>
    <Color x:Key="BgMenuItemPressedColor">#FF4A4A4A</Color>
    <Color x:Key="AccentColor">#FFE8272A</Color>
    <Color x:Key="SeparatorColor">#FF404040</Color>
    <Color x:Key="TextPrimaryColor">#FFDDDDDD</Color>
    <Color x:Key="TextDimColor">#FF888888</Color>
    <Color x:Key="TextAccentColor">#FFFF4444</Color>

    <SolidColorBrush x:Key="BgDeepBrush"           Color="{StaticResource BgDeepColor}"/>
    <SolidColorBrush x:Key="BgPanelBrush"          Color="{StaticResource BgPanelColor}"/>
    <SolidColorBrush x:Key="BgMenuBrush"            Color="{StaticResource BgMenuColor}"/>
    <SolidColorBrush x:Key="BgMenuItemHoverBrush"   Color="{StaticResource BgMenuItemHoverColor}"/>
    <SolidColorBrush x:Key="BgMenuItemPressedBrush" Color="{StaticResource BgMenuItemPressedColor}"/>
    <SolidColorBrush x:Key="AccentBrush"            Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SeparatorBrush"         Color="{StaticResource SeparatorColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"       Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextDimBrush"           Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="TextAccentBrush"        Color="{StaticResource TextAccentColor}"/>

    <Style x:Key="MenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="#b0b0b0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0 4 13.5 0"></Setter>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="5,0"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            VerticalAlignment="Center">
                        <Grid>
                            <ContentPresenter x:Name="header"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource BgMenuBrush}"
                                        BorderBrush="{StaticResource SeparatorBrush}"
                                        BorderThickness="1"
                                        Padding="0,4">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="header" Property="TextElement.Foreground" Value="#F0F0F0"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="header" Property="TextElement.Foreground" Value="#F0F0F0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="header" Property="TextElement.Foreground" Value="#696969"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MainMenuStyle" TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource BgMenuBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>


    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource BgMenuItemHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource BgMenuItemPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ── ScrollBar ── -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Width"       Value="6"/>
        <Setter Property="MinWidth"    Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="#181818" CornerRadius="3">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumb" Background="#505050" CornerRadius="3"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="#707070"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="#909090"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height"    Value="6"/>
                <Setter Property="MinHeight" Value="6"/>
                <Setter Property="Width"     Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="#181818" CornerRadius="3">
                                <Track x:Name="PART_Track" Margin="1">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="thumb" Background="#505050" CornerRadius="3"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="thumb" Property="Background" Value="#707070"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="thumb" Property="Background" Value="#909090"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Toolbar: separador vertical ── -->
    <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="27"/>
        <Setter Property="Width" Value="1"/>
        <Setter Property="Background" Value="#3b3b3b"/>
    </Style>

    <!-- ── Toolbar: contenedor seleccionable (envuelve ToolbarIconStyle) ── -->
    <Style x:Key="ToolbarIconContainerStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(local:ToolbarProperties.IsSelected), RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="BorderBrush" Value="#91bfcf"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ── Toolbar: icono ── -->
    <Style x:Key="ToolbarIconStyle" TargetType="Image">
        <Setter Property="Width" Value="21"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Toolbar: etiqueta de texto ── -->
    <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- ── Toolbar: botón toggle (Local / Global) ── -->
    <Style x:Key="ToolbarToggleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#3f4140"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="#bbc0b9"/>
        <Setter Property="Width" Value="65"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="#aad4e8"/>
                            <Setter TargetName="bg" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ComboBoxItem oscuro ── -->
    <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#c5c8bf"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bg"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#3d3d3d"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Hierarchy panel: separador horizontal ── -->
    <Style x:Key="HierarchySeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="2"/>
        <Setter Property="Background" Value="#1c1c1c"/>
    </Style>

    <!-- ── Hierarchy panel: contenedor de icono (16×16) ── -->
    <Style x:Key="HierarchyIconBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="#6f6f6f"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="1,0,0,0"/>
        <Setter Property="Background" Value="#181818"/>
    </Style>

    <!-- ── Hierarchy panel: caja de búsqueda ── -->
    <Style x:Key="HierarchySearchBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#6e6e6e"/>
        <Setter Property="Foreground" Value="#6e6e6e"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="15,0,0,0"/>
        <Setter Property="FontFamily" Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── ComboBox oscuro ── -->
    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="#c5c8bf"/>
        <Setter Property="Background" Value="#404040"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#656565"
                                BorderThickness="1"/>
                        <ContentPresenter Margin="5,0,25,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"/>
                        <Path HorizontalAlignment="Right"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Fill="#b7b7b7"
                              Data="M 0 0 L 4 4 L 8 0 Z"/>
                        <ToggleButton Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Background="Transparent"
                                      BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border Background="#2b2b2b"
                                    BorderBrush="#656565"
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="300">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#91bfcf"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ── Hierarchy: TreeView container ── -->
    <Style x:Key="HierarchyTreeViewStyle" TargetType="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- ── Hierarchy: TreeViewItem ── -->
    <Style x:Key="HierarchyTreeViewItemStyle" TargetType="TreeViewItem">
        <Setter Property="ItemsSource" Value="{Binding Children}"/>
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <!-- Row -->
                        <Grid x:Name="RowBg" Background="Transparent" Height="19" Margin="5,0,5,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- visibility border -->
                                <ColumnDefinition Width="Auto"/>  <!-- eye border -->
                                <ColumnDefinition Width="20"/>    <!-- expander -->
                                <ColumnDefinition Width="12"/>    <!-- item icon -->
                                <ColumnDefinition Width="*"/>     <!-- name -->
                                <ColumnDefinition Width="Auto"/>  <!-- extra border -->
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource HierarchyIconBorderStyle}">
                                <Image Width="11" Source="pack://application:,,,/Assets/img/restart.png"/>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource HierarchyIconBorderStyle}">
                                <Image Width="11" Source="pack://application:,,,/Assets/img/eye.png"/>
                            </Border>

                            <!-- Expand/collapse toggle (hidden if no children) -->
                            <ToggleButton x:Name="Expander" Grid.Column="2"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Visibility="Collapsed" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Path x:Name="Arr"
                                                  Data="M 3 1 L 9 5.5 L 3 10 Z"
                                                  Fill="#666666"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arr" Property="Data" Value="M 0 2 L 9 2 L 4.5 9 Z"/>
                                                <Setter TargetName="Arr" Property="Fill" Value="#aaaaaa"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arr" Property="Fill" Value="#ffffff"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Image x:Name="ItemIcon" Grid.Column="3" Width="11"
                                   Source="pack://application:,,,/Assets/img/object.png"
                                   VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="4" Text="{Binding Name}"
                                       Margin="4,1,0,0" VerticalAlignment="Center"
                                       Foreground="#DDDDDD" FontSize="13"
                                       FontFamily="pack://application:,,,/Assets/fonts/#DIN Alternate"/>

                            <Border Grid.Column="5" Style="{StaticResource HierarchyIconBorderStyle}"/>
                        </Grid>

                        <!-- Children (visible when expanded) -->
                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" Margin="16,0,0,0"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBg" Property="Background" Value="#2e4652"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding ItemType}" Value="Scene">
                            <Setter TargetName="ItemIcon" Property="Source"
                                    Value="pack://application:,,,/Assets/img/scene_folder.png"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ItemType}" Value="Folder">
                            <Setter TargetName="ItemIcon" Property="Source"
                                    Value="pack://application:,,,/Assets/img/folder.png"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Editor layout: panel frame ── -->
    <Style x:Key="EditorPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ── Editor layout: panel header label ── -->
    <Style x:Key="EditorPanelHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ToolbarLabelStyle}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#d4d4d4"/>
    </Style>

    <!-- ── Editor layout: panel header icon ── -->
    <Style x:Key="EditorPanelHeaderIconStyle" TargetType="Image" BasedOn="{StaticResource ToolbarIconStyle}">
        <Setter Property="Width" Value="11"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- ── Editor layout: vertical splitter ── -->
    <Style x:Key="PanelGridSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="#2a2a2a"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- ── Asset Browser: navigation button ── -->
    <Style x:Key="AssetNavButtonStyle" TargetType="Button">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="#909090"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"  Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#313131"/>
                            <Setter Property="Foreground" Value="#d8d8d8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#3d3d3d"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#404040"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Asset Browser: breadcrumb segment button ── -->
    <Style x:Key="BreadcrumbButtonStyle" TargetType="Button">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Foreground"       Value="White"/>
        <Setter Property="FontSize"         Value="14"/>
        <Setter Property="FontFamily"       Value="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
        <Setter Property="Padding"          Value="2,0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#2a2a2a"/>
                            <Setter Property="Foreground" Value="#d0d0d0"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#333333"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Asset Browser: folder tree ── -->
    <Style x:Key="AssetFolderTreeStyle" TargetType="TreeView">
        <Setter Property="Background"     Value="#1e1e1e"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"        Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
    </Style>

    <!-- ── Asset Browser: folder tree item ── -->
    <Style x:Key="AssetFolderItemStyle" TargetType="TreeViewItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding"     Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Grid x:Name="RowBg" Background="Transparent" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton x:Name="Expander" Grid.Column="0"
                                          IsChecked="{Binding IsExpanded,
                                              RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Visibility="Collapsed" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Path x:Name="Arr" Fill="#666"
                                                  Data="M 3 2 L 9 7 L 3 12 Z"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arr" Property="Data"  Value="M 1 3 L 9 3 L 5 9 Z"/>
                                                <Setter TargetName="Arr" Property="Fill"  Value="#aaa"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arr" Property="Fill" Value="#eee"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Image Grid.Column="1" Width="12" VerticalAlignment="Center"
                                   Source="pack://application:,,,/Assets/img/folder.png"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                       VerticalAlignment="Center"
                                       Foreground="#c0c0c0" FontSize="12"
                                       Margin="3,0,4,0"
                                       FontFamily="pack://application:,,,/Assets/fonts/#DIN Alternate"/>
                        </Grid>

                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" Margin="14,0,0,0"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBg" Property="Background" Value="#1e3a50"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Floating panel resize grip (bottom-right corner) ── -->
    <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Cursor" Value="SizeNWSE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Canvas Width="12" Height="12">
                        <Line X1="4" Y1="11" X2="11" Y2="4" Stroke="#484848" StrokeThickness="1.2"/>
                        <Line X1="7" Y1="11" X2="11" Y2="7" Stroke="#484848" StrokeThickness="1.2"/>
                        <Line X1="10" Y1="11" X2="11" Y2="10" Stroke="#484848" StrokeThickness="1.2"/>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
