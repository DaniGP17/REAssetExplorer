<Window x:Class="REAssetExplorer.TestUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:REAssetExplorer.TestUI"
        xmlns:controls="clr-namespace:REAssetExplorer.TestUI.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:svg="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        Title="REAssetExplorer"
        Width="2450" Height="1320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <DockPanel x:Name="RootPanel">

        <!-- ── Title bar ── -->
        <Grid DockPanel.Dock="Top" Height="30" Background="{StaticResource BgMenuBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Menu Grid.Column="0"
                  Style="{StaticResource MainMenuStyle}"
                  VerticalAlignment="Center"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem IsHitTestVisible="False" Padding="0" Background="Transparent">
                    <MenuItem.Header>
                        <Image Source="Assets/img/re_engine.jpg" Width="30" Margin="0,0,0,0"/>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Header="_File"    Style="{StaticResource MenuItemStyle}"/>
                <MenuItem Header="_Edit"    Style="{StaticResource MenuItemStyle}"/>
                <MenuItem Header="_View"    Style="{StaticResource MenuItemStyle}"/>
                <MenuItem Header="_Project" Style="{StaticResource MenuItemStyle}"/>
                <MenuItem Header="_Windows" Style="{StaticResource MenuItemStyle}"/>
                <MenuItem Header="_Custom"  Style="{StaticResource MenuItemStyle}" IsEnabled="False"/>
                <MenuItem Header="_Develop" Style="{StaticResource MenuItemStyle}"/>
                <MenuItem Header="_Help"    Style="{StaticResource MenuItemStyle}"/>
            </Menu>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" ToolTip="Minimizar"  Click="OnMinimize"/>
                <Button x:Name="MaxRestoreButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" ToolTip="Maximizar" Click="OnMaxRestore"/>
                <Button Style="{StaticResource CloseButtonStyle}"   Content="&#xE8BB;" ToolTip="Cerrar"     Click="OnClose"/>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Height="2" Margin="0,2,0,0" Background="#3b3b3b"/>

        <!-- ── Toolbar ── -->
        <Border DockPanel.Dock="Top" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="2.3,0,0,0">
                <svg:SvgViewbox Source="Assets/img/add_file.svg" Width="22" Height="22" Margin="6,0"/>
                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/folder.png"    Width="22" Margin="14,0,0,0"/>
                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/save.png"      Width="20" Margin="14,0,0,0"/>
                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/saveall.png"   Width="21" Margin="14,0,0,0"/>

                <Border Style="{StaticResource ToolbarSeparatorStyle}" Margin="14,0,0,0"/>

                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/back_arrow.png"   Margin="12,0,0,0"/>
                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/detail_arrow.png" Width="6" Margin="9,0,0,0"/>
                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/back_arrow.png"   FlowDirection="RightToLeft" Margin="11,0,0,0"/>
                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/detail_arrow.png" Width="6" Margin="9,0,0,0"/>

                <Border Style="{StaticResource ToolbarSeparatorStyle}" Width="2" Margin="11,0,0,0"/>

                <Border Style="{StaticResource ToolbarIconContainerStyle}" Margin="13,0,0,0" local:ToolbarProperties.IsSelected="False">
                    <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/position.png"/>
                </Border>
                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/rotation.png"    Margin="13,0,0,0"/>
                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/scale.png"       Margin="13,0,0,0"/>
                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/settings.png"    Margin="13,0,0,0"/>
                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/detail_arrow.png" Width="6" Margin="9,0,0,0"/>

                <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="View:" Margin="14,0,0,0"/>
                <Button Style="{StaticResource ToolbarToggleButtonStyle}" Content="Local"  BorderBrush="#91bfcf" BorderThickness="1.3" Margin="5,0,0,0"/>
                <Button Style="{StaticResource ToolbarToggleButtonStyle}" Content="Global"/>

                <Border Style="{StaticResource ToolbarSeparatorStyle}" Width="2" Margin="6,0,0,0"/>

                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/vertex_snap.png" Margin="11,0,0,0"/>

                <Border Style="{StaticResource ToolbarSeparatorStyle}" Width="2" Margin="11,0,0,0"/>

                <TextBlock Style="{StaticResource ToolbarLabelStyle}" Text="Target:" Margin="8,0,0,0"/>
                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"
                          Width="125" Height="25" Margin="8,0,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="None"/>
                </ComboBox>

                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/restart.png" Margin="9,0,0,0"/>

                <Border Style="{StaticResource ToolbarSeparatorStyle}" Width="2" Margin="11,0,0,0"/>

                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/stop.png"   Margin="13,0,0,0"/>
                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/start.png"  Margin="13,0,0,0"/>
                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/eject.png"  Margin="13,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── Main area + status bar ── -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- DockingArea fills the background; FloatingCanvas overlays it -->
            <Grid Grid.Row="0">
                <controls:DockingArea x:Name="DockArea"/>

                <!-- Floating panels live here when undocked.
                     Panels are initially defined here so x:Name resolves,
                     then moved to DockArea in the constructor. -->
                <Canvas x:Name="FloatingCanvas">

                    <!-- ── Hierarchy panel ── -->
                    <controls:FloatingPanel x:Name="HierarchyPanel"
                            Width="380" Height="720"
                            Title="Hierarchy"
                            HeaderMouseLeftButtonDown="OnHeaderDragStart"
                            HeaderMouseMove="OnHeaderDragMove"
                            HeaderMouseLeftButtonUp="OnHeaderDragEnd"
                            PanelClosed="OnPanelClosed">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/scene_select.png" Width="20" Margin="5,0,0,0"/>
                                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/restart.png"      Width="19" Margin="5,0,0,0"/>
                                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/scene_layer.png"  Width="19" Margin="5,0,0,0"/>
                                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/scene_swap.png"   Width="19" Margin="5,0,0,0"/>
                                <Image Style="{StaticResource ToolbarIconStyle}" Source="Assets/img/scene_filter.png" Width="19" Margin="5,0,0,0"/>
                                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"
                                          Width="80" Height="25" Margin="8,0,3,0" SelectedIndex="0"
                                          DockPanel.Dock="Right">
                                    <ComboBoxItem Content="500ms"/>
                                </ComboBox>
                                <Image Style="{StaticResource ToolbarIconStyle}" Width="15"
                                       Source="Assets/img/scene_divide.png" DockPanel.Dock="Right"/>
                            </DockPanel>

                            <Grid DockPanel.Dock="Top" Background="#181818" Height="28">
                                <Image Style="{StaticResource ToolbarIconStyle}" Width="10"
                                       Source="Assets/img/search.png" HorizontalAlignment="Left" Margin="5,0,0,0"/>
                                <TextBox Style="{StaticResource HierarchySearchBoxStyle}" Text="Search"/>
                                <Image Style="{StaticResource ToolbarIconStyle}" Width="13"
                                       Source="Assets/img/filter.png" HorizontalAlignment="Right" Margin="0,0,3,0"/>
                                <Image Style="{StaticResource ToolbarIconStyle}" Width="7"
                                       Source="Assets/img/detail_arrow.png" HorizontalAlignment="Right" Margin="0,0,20,0"/>
                            </Grid>

                            <Border DockPanel.Dock="Top" Style="{StaticResource HierarchySeparatorStyle}" Margin="0,2,0,0"/>

                            <TextBlock DockPanel.Dock="Top"
                                       Margin="5"
                                       Text="NewScene"
                                       FontFamily="pack://application:,,,/Assets/fonts/#DIN Alternate"
                                       FontSize="14"
                                       Background="#3d3e40"
                                       HorizontalAlignment="Left"
                                       Foreground="#d2d3d7"
                                       Padding="5"/>

                            <Border DockPanel.Dock="Top" Style="{StaticResource HierarchySeparatorStyle}" Margin="0,2,0,2"/>

                            <TreeView Style="{StaticResource HierarchyTreeViewStyle}"
                                      ItemContainerStyle="{StaticResource HierarchyTreeViewItemStyle}"/>
                        </DockPanel>
                    </controls:FloatingPanel>

                    <!-- ── Scene panel ── -->
                    <controls:FloatingPanel x:Name="ScenePanel"
                            Width="900" Height="700"
                            Title="Scene" Subtitle="Perspective"
                            HeaderMouseLeftButtonDown="OnHeaderDragStart"
                            HeaderMouseMove="OnHeaderDragMove"
                            HeaderMouseLeftButtonUp="OnHeaderDragEnd"
                            PanelClosed="OnPanelClosed">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="28"
                                    Background="#1e1e1e" BorderBrush="#2f2f2f" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="View:"      Style="{StaticResource ToolbarLabelStyle}" Margin="0,0,6,0"/>
                                    <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"
                                              Width="90" Height="22" SelectedIndex="0">
                                        <ComboBoxItem Content="Default"/>
                                    </ComboBox>
                                    <TextBlock Text="Rendering:" Style="{StaticResource ToolbarLabelStyle}" Margin="14,0,6,0"/>
                                    <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"
                                              Width="90" Height="22" SelectedIndex="0">
                                        <ComboBoxItem Content="Default"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <controls:SceneViewHost/>
                        </DockPanel>
                    </controls:FloatingPanel>

                    <!-- ── Inspector panel ── -->
                    <controls:FloatingPanel x:Name="InspectorPanel"
                            Width="380" Height="460"
                            Title="Inspector"
                            HeaderMouseLeftButtonDown="OnHeaderDragStart"
                            HeaderMouseMove="OnHeaderDragMove"
                            HeaderMouseLeftButtonUp="OnHeaderDragEnd"
                            PanelClosed="OnPanelClosed">
                        <controls:ObjectInspector/>
                    </controls:FloatingPanel>

                    <!-- ── Asset Browser panel ── -->
                    <controls:FloatingPanel x:Name="AssetBrowserPanel"
                            Width="900" Height="300"
                            Title="Asset Browser"
                            HeaderMouseLeftButtonDown="OnHeaderDragStart"
                            HeaderMouseMove="OnHeaderDragMove"
                            HeaderMouseLeftButtonUp="OnHeaderDragEnd"
                            PanelClosed="OnPanelClosed">
                        <controls:AssetBrowserPanel/>
                    </controls:FloatingPanel>

                </Canvas>
            </Grid>

            <!-- ── Status bar ── -->
            <Border Grid.Row="1" Background="#1a1a1a" BorderBrush="#2f2f2f" BorderThickness="1,1,1,0" Padding="8,4">
                <DockPanel>
                    <TextBlock Text="Ready"          Foreground="#c8c8c8" FontSize="12"/>
                    <TextBlock Text="Scene: NewScene" Foreground="#9f9f9f" FontSize="12" Margin="14,0,0,0"/>
                    <TextBlock Text="Objects: --"    Foreground="#9f9f9f" FontSize="12" Margin="14,0,0,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="REAssetExplorer" Foreground="#7f7f7f" FontSize="12"/>
                </DockPanel>
            </Border>
        </Grid>

    </DockPanel>
</Window>
