<Window x:Class="REAssetExplorer.TestUI.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="REAssetExplorer"
        Width="400"
        SizeToContent="Height"
        MinHeight="130"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="pack://application:,,,/Assets/fonts/#DIN Alternate">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>

        <!-- ── Title bar ── -->
        <Grid DockPanel.Dock="Top" Height="30" Background="{StaticResource BgMenuBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="REAssetExplorer"
                       Foreground="#606060"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="10,0"/>

            <Button Grid.Column="1"
                    Style="{StaticResource CloseButtonStyle}"
                    Content="&#xE8BB;"
                    ToolTip="Close"
                    Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                    Click="OnClose"/>
        </Grid>

        <!-- ── Separator ── -->
        <Border DockPanel.Dock="Top" Height="1" Background="#2a2a2a"/>

        <!-- ── Content ── -->
        <StackPanel Margin="28,22,28,26">

            <!-- Type row: colored icon + label -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                        VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="4"
                        Background="{Binding TypeColor}"
                        Margin="0,0,14,0">
                    <TextBlock Text="{Binding TypeIcon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding TypeLabel}"
                           FontSize="18"
                           Foreground="#dddddd"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Message -->
            <TextBlock Text="{Binding Message}"
                       FontSize="13"
                       Foreground="#888888"
                       TextWrapping="Wrap"
                       LineHeight="18"/>

            <!-- Progress bar (Loading only) -->
            <Border Height="3" CornerRadius="2" Background="#2a2a2a"
                    Margin="0,20,0,0"
                    ClipToBounds="True"
                    Visibility="{Binding LoadingVisibility}">
                <Border x:Name="ProgressIndicator"
                        Width="110" HorizontalAlignment="Left" CornerRadius="2"
                        Background="{Binding TypeColor}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgressSlide" X="-110"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetName="ProgressSlide"
                                        Storyboard.TargetProperty="X"
                                        From="-110" To="400"
                                        Duration="0:0:1.3"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </Border>

        </StackPanel>

    </DockPanel>
</Window>
