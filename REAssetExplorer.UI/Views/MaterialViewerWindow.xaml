<ui:FluentWindow x:Class="REAssetExplorer.UI.Views.MaterialViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Material Viewer" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    
    <ui:FluentWindow.Resources>
        <Style TargetType="ui:Card">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar with Window Controls -->
        <ui:TitleBar Grid.Row="0" 
                     Title="Material Viewer"
                     Icon="pack://application:,,,/Assets/icon.ico"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Material Information -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        
                        <!-- Material Name Card -->
                        <ui:Card>
                            <StackPanel>
                                <TextBlock Text="MATERIAL NAME" 
                                           FontSize="11" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="MaterialNameText" 
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- Basic Info Card -->
                        <ui:Card>
                            <StackPanel>
                                <TextBlock Text="BASIC INFORMATION" 
                                           FontSize="11" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,12"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Shader Type:" 
                                               Grid.Row="0" Grid.Column="0"
                                               Margin="0,0,12,8"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="ShaderTypeText"
                                               Grid.Row="0" Grid.Column="1"
                                               Margin="0,0,0,8"
                                               TextWrapping="Wrap"
                                               FontWeight="Medium"/>

                                    <TextBlock Text="Texture Count:" 
                                               Grid.Row="1" Grid.Column="0"
                                               Margin="0,0,12,8"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="TextureCountText"
                                               Grid.Row="1" Grid.Column="1"
                                               Margin="0,0,0,8"
                                               FontWeight="Medium"/>

                                    <TextBlock Text="Property Count:" 
                                               Grid.Row="2" Grid.Column="0"
                                               Margin="0,0,12,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="PropertyCountText"
                                               Grid.Row="2" Grid.Column="1"
                                               FontWeight="Medium"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Master Material Card -->
                        <ui:Card>
                            <StackPanel>
                                <TextBlock Text="MASTER MATERIAL" 
                                           FontSize="11" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="MasterMaterialText" 
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas"
                                           FontSize="11"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- Flags Card -->
                        <ui:Card>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="FLAGS" 
                                               FontSize="11" 
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FlagsCountText"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                                <ItemsControl x:Name="FlagsListBox">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    Margin="0,0,4,4">
                                                <TextBlock Text="{Binding}" 
                                                           FontSize="11"
                                                           FontWeight="Medium"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>

                        <!-- Textures Expander -->
                        <ui:Card>
                            <Expander IsExpanded="True" 
                                      Header="TEXTURES"
                                      Background="Transparent">
                                <Expander.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </Expander.HeaderTemplate>
                                <ItemsControl x:Name="TexturesListBox" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="6"
                                                    Padding="12"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Checkbox to enable/disable texture -->
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsEnabled}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"
                                                              Checked="TextureCheckBox_Changed"
                                                              Unchecked="TextureCheckBox_Changed"/>
                                                    
                                                    <!-- Texture Preview -->
                                                    <Border Grid.Column="1"
                                                            Width="56"
                                                            Height="56"
                                                            CornerRadius="4"
                                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            Margin="0,0,12,0"
                                                            Cursor="Hand"
                                                            MouseDown="TexturePreview_MouseDown"
                                                            Tag="{Binding}">
                                                        <Grid>
                                                            <Image Source="{Binding PreviewImage}"
                                                                   Stretch="UniformToFill"/>
                                                            <ui:SymbolIcon Symbol="Image24"
                                                                           FontSize="24"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                           Visibility="{Binding PreviewImageVisibility}"/>
                                                        </Grid>
                                                    </Border>
                                                    
                                                    <!-- Texture Info -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Type}" 
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding Path}" 
                                                                   TextWrapping="Wrap"
                                                                   FontSize="10"
                                                                   FontFamily="Consolas"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </ui:Card>

                        <!-- Properties Expander -->
                        <ui:Card>
                            <Expander IsExpanded="True" 
                                      Header="PROPERTIES"
                                      Background="Transparent">
                                <Expander.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" 
                                                   FontSize="11" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </DataTemplate>
                                </Expander.HeaderTemplate>
                                <ItemsControl x:Name="PropertiesListBox" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="6"
                                                    Padding="12"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               Margin="0,0,0,8"/>
                                                    
                                                    <!-- Editable Parameters -->
                                                    <ItemsControl ItemsSource="{Binding Parameters}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Label}"
                                                                               FontSize="10"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,8,0"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                    
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Value}"
                                                                               FontSize="11"
                                                                               FontFamily="Consolas"
                                                                               VerticalAlignment="Center"
                                                                               FontWeight="Medium"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    
                                                    <!-- No Parameters Message -->
                                                    <TextBlock Text="No parameters available"
                                                               FontSize="10"
                                                               FontStyle="Italic"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Visibility="{Binding NoParametersVisibility}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </ui:Card>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel - 3D Preview -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Cube24" 
                                           FontSize="20"
                                           Margin="0,0,12,0"/>
                            <TextBlock Text="3D Preview" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Reset Camera" 
                                       x:Name="ResetCameraButton"
                                       Click="ResetCameraButton_Click"
                                       Icon="{ui:SymbolIcon Camera24}"
                                       Appearance="Secondary"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DirectX11 Render Surface -->
                <Border Grid.Row="1" 
                        Background="#FF1E1E1E"
                        x:Name="RenderBorder">
                    <Grid>
                        <Image x:Name="RenderImage" 
                               Stretch="Fill"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"/>
                        <TextBlock Text="Initializing DirectX11..."
                                   x:Name="StatusText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="White"/>
                    </Grid>
                </Border>

                <!-- Bottom Info Bar -->
                <Border Grid.Row="2"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <Grid>
                        <TextBlock x:Name="InfoText"
                                   Text="DirectX 11 • Hardware Rendering • 60 FPS"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
