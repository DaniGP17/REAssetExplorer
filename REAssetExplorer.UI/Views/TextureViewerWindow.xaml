<ui:FluentWindow x:Class="REAssetExplorer.UI.Views.TextureViewerWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                mc:Ignorable="d"
                Title="Texture Viewer"
                Height="700"
                Width="900"
                MinHeight="500"
                MinWidth="700"
                WindowStartupLocation="CenterScreen"
                ExtendsContentIntoTitleBar="True"
                WindowBackdropType="Mica"
                d:Background="#1E1E1E"
                d:Foreground="#FFFFFF"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid d:Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" 
                     Title="Texture Viewer"
                     Icon="pack://application:,,,/Assets/icon.ico"/>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Image Preview Area -->
            <Border Grid.Column="0" 
                    Background="#1E1E1E"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,10,0">
                <Grid>
                    <Rectangle x:Name="CheckerboardBackground" Visibility="Collapsed">
                        <Rectangle.Fill>
                            <DrawingBrush Viewport="0,0,20,20" 
                                          ViewportUnits="Absolute" 
                                          TileMode="Tile">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#2A2A2A">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="0,0,10,10"/>
                                                    <RectangleGeometry Rect="10,10,10,10"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#1A1A1A">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="10,0,10,10"/>
                                                    <RectangleGeometry Rect="0,10,10,10"/>
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <ScrollViewer x:Name="ImageScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="10">
                        <Grid>
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="ImageScaleTransform" 
                                                ScaleX="1" 
                                                ScaleY="1"/>
                            </Grid.LayoutTransform>
                            
                            <Image x:Name="TextureImage"
                                   Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            
                            <!-- Loading Indicator -->
                            <ui:ProgressRing x:Name="LoadingIndicator"
                                             IsIndeterminate="True"
                                             Width="60"
                                             Height="60"
                                             Visibility="Collapsed"/>
                            
                            <!-- Error Message -->
                            <TextBlock x:Name="ErrorMessage"
                                       Foreground="#FF4444"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="20"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>
                    
                    <!-- Zoom Controls -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Background="#252526"
                                Opacity="0.9">
                        <Button Width="30" Height="30" Margin="0 0 10 0" Padding="0"
                                Click="ZoomIn_Click">
                            <Grid>
                                <ui:SymbolIcon Symbol="ZoomIn16"
                                               FontSize="20"
                                               Filled="False"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Width="30" Height="30" Margin="0 0 10 0" Padding="0"
                                Click="ZoomReset_Click">
                            <Grid>
                                <ui:SymbolIcon Symbol="ZoomFit16"
                                               FontSize="20"
                                               Filled="False"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Width="30" Height="30" Margin="0 0 10 0" Padding="0"
                                Click="ZoomOut_Click">
                            <Grid>
                                <ui:SymbolIcon Symbol="ZoomOut16"
                                               FontSize="20"
                                               Filled="False"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Info Panel -->
            <Border Grid.Column="1"
                    Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Texture Information"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,15"/>

                            <!-- File Name -->
                            <TextBlock Text="File Name"
                                       FontSize="11"
                                       Foreground="#A0A0A0"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="FileNameText"
                                       Text="texture.tex"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,15"/>

                            <!-- Dimensions -->
                            <TextBlock Text="Dimensions"
                                       FontSize="11"
                                       Foreground="#A0A0A0"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="DimensionsText"
                                       Text="1024 x 1024"
                                       FontSize="13"
                                       Margin="0,0,0,15"/>

                            <!-- Format -->
                            <TextBlock Text="Format"
                                       FontSize="11"
                                       Foreground="#A0A0A0"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="FormatText"
                                       Text="DXT5"
                                       FontSize="13"
                                       Margin="0,0,0,15"/>

                            <!-- Mipmaps -->
                            <TextBlock Text="Mipmap Levels"
                                       FontSize="11"
                                       Foreground="#A0A0A0"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="MipmapText"
                                       Text="10"
                                       FontSize="13"
                                       Margin="0,0,0,5"/>
                            
                            <!-- Mipmap Selector -->
                            <TextBlock Text="View Mipmap Level"
                                       FontSize="11"
                                       Foreground="#A0A0A0"
                                       Margin="0,5,0,5"/>
                            <ComboBox x:Name="MipmapSelector"
                                      Margin="0,0,0,15"
                                      SelectionChanged="MipmapSelector_SelectionChanged"/>

                            <!-- Alpha Channel -->
                            <TextBlock Text="Alpha Channel"
                                       FontSize="11"
                                       Foreground="#A0A0A0"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="AlphaText"
                                       Text="Yes"
                                       FontSize="13"
                                       Margin="0,0,0,15"/>

                            <!-- File Size -->
                            <TextBlock Text="Data Size"
                                       FontSize="11"
                                       Foreground="#A0A0A0"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="DataSizeText"
                                       Text="512 KB"
                                       FontSize="13"
                                       Margin="0,0,0,15"/>

                            <!-- Compression -->
                            <TextBlock Text="Compression"
                                       FontSize="11"
                                       Foreground="#A0A0A0"
                                       Margin="0,0,0,5"/>
                            <TextBlock x:Name="CompressionText"
                                       Text="ZStandard"
                                       FontSize="13"
                                       Margin="0,0,0,20"/>

                            <!-- Alpha Channel Toggle -->
                            <TextBlock Text="Show Alpha Channel"
                                       FontSize="11"
                                       Foreground="#A0A0A0"
                                       Margin="0,0,0,5"/>
                            <ui:ToggleSwitch x:Name="TransparencyToggle"
                                             OffContent="Off" 
                                             OnContent="On"
                                             Margin="0,0,0,15"
                                             Checked="ToggleTransparency_Changed"
                                             Unchecked="ToggleTransparency_Changed"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Export Button (Pinned to Bottom) -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <ui:Button Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Icon="{ui:SymbolIcon Save24}"
                                   Appearance="Primary"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Bottom"
                                   Padding="10,6"
                                   Click="ExportAsPng_Click">
                            <TextBlock Text="Export"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,0,30,0"/>
                        </ui:Button>
                        
                        <ui:Button Grid.Column="1"
                                   Width="40"
                                   Appearance="Primary"
                                   Height="30"
                                   Padding="0"
                                   Margin="0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Stretch"
                                   BorderThickness="1,0,0,0"
                                   BorderBrush="#00000040"
                                   Click="ExportDropdown_Click">
                            <ui:Button.ContextMenu>
                                <ContextMenu x:Name="ExportContextMenu" Placement="Bottom">
                                    <MenuItem Header="PNG" Click="ExportAsPng_Click"/>
                                    <MenuItem Header="DDS" Click="ExportAsDds_Click"/>
                                    <MenuItem Header="TGA" Click="ExportAsTga_Click"/>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                            <ui:SymbolIcon Symbol="ChevronDown20" 
                                           FontSize="14"
                                           Foreground="White"/>
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="0,1,0,0"
                Padding="10,5">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       FontSize="12"
                       Foreground="#A0A0A0"/>
        </Border>
    </Grid>
</ui:FluentWindow>
