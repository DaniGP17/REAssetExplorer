<Window x:Class="REAssetExplorer.App.Views.FileExplorer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:REAssetExplorer.App.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:REAssetExplorer.App.Controls"
        xmlns:models="clr-namespace:REAssetExplorer.UI.Models"
        xmlns:converters="clr-namespace:REAssetExplorer.UI.Converters"
        Background="#272727"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        MinWidth="700"
        MinHeight="450"
        Title="FileExplorer">
    <!-- If AllowTransparency is disabled the window can't be resized, so we have to find a way to remove white Border and allow window resize  -->
    
    <Window.Resources>
        <converters:FileIconColorConverter x:Key="IconColorConverter"/>
        
        <HierarchicalDataTemplate DataType="{x:Type models:TreeItem}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="{Binding Icon}"
                               FontSize="18"
                               Filled="True"
                               Margin="0 0 5 0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                    <ui:SymbolIcon.Foreground>
                        <MultiBinding Converter="{StaticResource IconColorConverter}">
                            <Binding Path="Icon"/>
                            <Binding Path="IsFolder"/>
                        </MultiBinding>
                    </ui:SymbolIcon.Foreground>
                </ui:SymbolIcon>
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>
    
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <DockPanel Grid.Row="0">
            <Menu FontSize="14" DockPanel.Dock="Left" Background="Transparent">
                <ui:MenuItem Header="File" Foreground="White" Icon="{ui:SymbolIcon Symbol=Document24}">
                    <ui:MenuItem Header="New" InputGestureText="CTRL+N" />
                    <ui:MenuItem Header="Open..." InputGestureText="CTRL+O" />
                    <ui:MenuItem Header="Save" InputGestureText="CTRL+S" />
                    <ui:MenuItem Header="Save As..." InputGestureText="CTRL+SHIFT+S" />
                    <Separator />
                    <ui:MenuItem Header="Exit" />
                </ui:MenuItem>
            </Menu>
            
            <controls:WindowControls />
            
            
        </DockPanel>
        
        <Grid Grid.Row="1" Margin="10 0 10 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Width="32" Height="32" Margin="0 0 10 0" Padding="0" Click="BackButton_Click">
                <Grid>
                    <ui:SymbolIcon Symbol="ArrowCircleLeft12"
                                   FontSize="20"
                                   Filled="True"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <Button Grid.Column="1" Width="32" Height="32" Margin="0 0 10 0" Padding="0" Click="UpButton_Click">
                <Grid>
                    <ui:SymbolIcon Symbol="ArrowUp12"
                                   FontSize="20"
                                   Filled="True"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <ui:TextBox Grid.Column="2"
                        x:Name="PathTextBox"
                        Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0 0 10 0"
                        KeyDown="PathTextBox_KeyDown"/>

            <Button Grid.Column="3" Width="32" Height="32" Margin="0 0 10 0" Padding="0" Click="RefreshButton_Click">
                <Grid>
                    <ui:SymbolIcon Symbol="ArrowSync12"
                                   FontSize="20"
                                   Filled="True"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <ui:ToggleSwitch Grid.Column="4"
                             OffContent="Edit Mode"
                             OnContent="Edit Mode"
                             Margin="0 0 10 0"/>

            <ui:TextBox Grid.Column="5"
                        x:Name="SearchTextBox"
                        PlaceholderText="Search file..."
                        Width="200"
                        KeyDown="SearchTextBox_KeyDown"/>
        </Grid>
        
        
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="600" />
                <ColumnDefinition Width="10"/> <!-- Splitter -->
                <ColumnDefinition Width="3*"/> 
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#323232" CornerRadius="8">
                <TreeView 
                    x:Name="FileTreeView"
                    ItemsSource="{Binding TreeManager.Root.Children}" 
                    Margin="10"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                    SelectedItemChanged="TreeView_SelectedItemChanged"
                />
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True" />

            <Border Grid.Column="2" Background="#323232" CornerRadius="3" Margin="10,0,0,0">
                <ui:DataGrid Margin="10" 
                             ItemsSource="{Binding DataGridFiles}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             IsReadOnly="True"
                             SelectionMode="Single"
                             HeadersVisibility="Column">
                    <ui:DataGrid.ContextMenu>
                        <ContextMenu>
                            <ui:MenuItem Header="View" 
                                         Icon="{ui:SymbolIcon Symbol=Eye16}"
                                         Click="MenuItem_View_Click"/>
                            <ui:MenuItem Header="View Hex" 
                                         Icon="{ui:SymbolIcon Symbol=Code16}"
                                         Click="MenuItem_ViewHex_Click"/>
                            <Separator/>
                            <ui:MenuItem Header="Export Raw" 
                                         Icon="{ui:SymbolIcon Symbol=DocumentCopy16}"
                                         Click="MenuItem_ExportRaw_Click"/>
                            <ui:MenuItem Header="Extract Uncompressed" 
                                         Icon="{ui:SymbolIcon Symbol=ArrowDownload16}"
                                         Click="MenuItem_ExtractUncompressed_Click"/>
                        </ContextMenu>
                    </ui:DataGrid.ContextMenu>
                    <ui:DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#404040"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#383838"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:DataGrid.RowStyle>
                    <ui:DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <ui:SymbolIcon Symbol="{Binding Icon}"
                                                       FontSize="18"
                                                       Filled="True"
                                                       Margin="5 0 8 0"
                                                       VerticalAlignment="Center">
                                            <ui:SymbolIcon.Foreground>
                                                <MultiBinding Converter="{StaticResource IconColorConverter}">
                                                    <Binding Path="Icon"/>
                                                    <Binding Path="IsFolder"/>
                                                </MultiBinding>
                                            </ui:SymbolIcon.Foreground>
                                        </ui:SymbolIcon>
                                        <TextBlock Text="{Binding Name}" 
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="Type" 
                                            Binding="{Binding Type}" 
                                            Width="*" 
                                            MinWidth="100"/>
                        
                        <DataGridTextColumn Header="Size" 
                                            Binding="{Binding Size}" 
                                            Width="*" 
                                            MinWidth="90"/>
                        
                        <DataGridTextColumn Header="Compressed" 
                                            Binding="{Binding CompressedSize}" 
                                            Width="*" 
                                            MinWidth="90"/>
                        
                        <DataGridTextColumn Header="Checksum" 
                                            Binding="{Binding Checksum}" 
                                            Width="*" 
                                            MinWidth="140"/>
                        
                        <DataGridTextColumn Header="Compression" 
                                            Binding="{Binding Compression}" 
                                            Width="*" 
                                            MinWidth="120"/>
                    </ui:DataGrid.Columns>
                </ui:DataGrid>
            </Border>
        </Grid>

    </Grid>
</Window>
