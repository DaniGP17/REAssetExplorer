<ui:FluentWindow x:Class="REAssetExplorer.UI.Views.MeshViewerWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:converters="clr-namespace:REAssetExplorer.UI.Converters"
                mc:Ignorable="d"
                Title="Mesh Viewer"
                Height="800"
                Width="1280"
                MinHeight="600"
                MinWidth="900"
                WindowStartupLocation="CenterScreen"
                ExtendsContentIntoTitleBar="True"
                WindowBackdropType="Mica"
                d:Background="#1E1E1E"
                d:Foreground="#FFFFFF"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <converters:BoolToColorConverter x:Key="VisibilityToColorConverter"
                                         TrueColor="#4CAF50"
                                         FalseColor="#888888"/>
    </ui:FluentWindow.Resources>

    <Grid d:Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" 
                     Title="Mesh Viewer"
                     Icon="pack://application:,,,/Assets/icon.ico"/>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" MaxWidth="600"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Mesh Information -->
            <Border Grid.Column="0" 
                    Background="#1E1E1E"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,5,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0">
                        <!-- Loading Indicator -->
                        <ui:ProgressRing x:Name="LoadingIndicator" 
                                        IsIndeterminate="True" 
                                        Visibility="Collapsed"
                                        Width="50" Height="50"
                                        Margin="0,40"/>

                        <!-- General Info Section -->
                        <Border Background="#252525" 
                                BorderBrush="#3F3F46" 
                                BorderThickness="0,0,0,1"
                                Padding="15,12">
                            <StackPanel>
                                <TextBlock Text="MESH PROPERTIES" 
                                          FontSize="11" 
                                          FontWeight="Bold"
                                          Foreground="#888888"
                                          Margin="0,0,0,12"/>
                                
                                <!-- File Name -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="File" 
                                              Grid.Column="0"
                                              Foreground="#999999"
                                              FontSize="13"/>
                                    <TextBlock x:Name="FileNameText" 
                                              Grid.Column="1"
                                              Text="-"
                                              TextWrapping="Wrap"
                                              Foreground="#E8E8E8"
                                              FontSize="13"
                                              Margin="10,0,0,0"/>
                                </Grid>
                                
                                <!-- LOD Count -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="LOD Levels" 
                                              Grid.Column="0"
                                              Foreground="#999999"
                                              FontSize="13"/>
                                    <TextBlock x:Name="LODCountText" 
                                              Grid.Column="1"
                                              Text="-"
                                              Foreground="#E8E8E8"
                                              FontSize="13"
                                              Margin="10,0,0,0"/>
                                </Grid>
                                
                                <!-- Vertices -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Vertices" 
                                              Grid.Column="0"
                                              Foreground="#999999"
                                              FontSize="13"/>
                                    <TextBlock x:Name="TotalVerticesText" 
                                              Grid.Column="1"
                                              Text="-"
                                              Foreground="#4CAF50"
                                              FontSize="13"
                                              FontWeight="SemiBold"
                                              Margin="10,0,0,0"/>
                                </Grid>
                                
                                <!-- Triangles -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Triangles" 
                                              Grid.Column="0"
                                              Foreground="#999999"
                                              FontSize="13"/>
                                    <TextBlock x:Name="TotalIndicesText" 
                                              Grid.Column="1"
                                              Text="-"
                                              Foreground="#2196F3"
                                              FontSize="13"
                                              FontWeight="SemiBold"
                                              Margin="10,0,0,0"/>
                                </Grid>
                                
                                <!-- Materials -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Materials" 
                                              Grid.Column="0"
                                              Foreground="#999999"
                                              FontSize="13"/>
                                    <TextBlock x:Name="MaterialCountText" 
                                              Grid.Column="1"
                                              Text="-"
                                              Foreground="#FF9800"
                                              FontSize="13"
                                              FontWeight="SemiBold"
                                              Margin="10,0,0,0"/>
                                </Grid>
                                
                                <!-- Skeleton -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Rigged" 
                                              Grid.Column="0"
                                              Foreground="#999999"
                                              FontSize="13"/>
                                    <TextBlock x:Name="HasSkeletonText" 
                                              Grid.Column="1"
                                              Text="-"
                                              Foreground="#E8E8E8"
                                              FontSize="13"
                                              Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Bounding Box Section -->
                        <Border Background="#252525" 
                                BorderBrush="#3F3F46" 
                                BorderThickness="0,0,0,1"
                                Padding="15,12">
                            <StackPanel>
                                <TextBlock Text="BOUNDING BOX" 
                                          FontSize="11" 
                                          FontWeight="Bold"
                                          Foreground="#888888"
                                          Margin="0,0,0,12"/>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Min" 
                                              Grid.Column="0"
                                              Foreground="#999999"
                                              FontSize="12"/>
                                    <TextBlock x:Name="BoundingMinText" 
                                              Grid.Column="1"
                                              Text="-"
                                              Foreground="#E8E8E8"
                                              FontSize="12"
                                              FontFamily="Consolas"
                                              Margin="10,0,0,0"/>
                                </Grid>
                                
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Max" 
                                              Grid.Column="0"
                                              Foreground="#999999"
                                              FontSize="12"/>
                                    <TextBlock x:Name="BoundingMaxText" 
                                              Grid.Column="1"
                                              Text="-"
                                              Foreground="#E8E8E8"
                                              FontSize="12"
                                              FontFamily="Consolas"
                                              Margin="10,0,0,0"/>
                                </Grid>
                                
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Radius" 
                                              Grid.Column="0"
                                              Foreground="#999999"
                                              FontSize="12"/>
                                    <TextBlock x:Name="BoundingRadiusText" 
                                              Grid.Column="1"
                                              Text="-"
                                              Foreground="#E8E8E8"
                                              FontSize="12"
                                              FontFamily="Consolas"
                                              Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Mesh Hierarchy Section -->
                        <Border Background="#1E1E1E" 
                                Padding="15,12">
                            <StackPanel>
                                <TextBlock Text="HIERARCHY" 
                                          FontSize="11" 
                                          FontWeight="Bold"
                                          Foreground="#888888"
                                          Margin="0,0,0,10"/>
                                
                                <TreeView x:Name="MeshHierarchyTree"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#E0E0E0"
                                         FontSize="12">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsChecked}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayName}"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="True"/>
                                            <Setter Property="Foreground" Value="#CCCCCC"/>
                                            <Setter Property="Padding" Value="4,3"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                            </StackPanel>
                        </Border>

                        <!-- Materials Section -->
                        <Border Background="#252525" 
                                BorderBrush="#3F3F46" 
                                BorderThickness="0,1,0,0"
                                Padding="15,12">
                            <StackPanel>
                                <TextBlock Text="MATERIALS" 
                                          FontSize="11" 
                                          FontWeight="Bold"
                                          Foreground="#888888"
                                          Margin="0,0,0,10"/>
                                
                                <ListView x:Name="MaterialsList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         MaxHeight="250"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0,4"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#2A2A2A"
                                                   BorderBrush="#3F3F46"
                                                   BorderThickness="1"
                                                   CornerRadius="3"
                                                   Padding="8,5"
                                                   Margin="0,2">
                                                <TextBlock Text="{Binding}" 
                                                          Foreground="#E8E8E8"
                                                          FontSize="12"
                                                          TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- GridSplitter for resizing -->
            <GridSplitter Grid.Column="1"
                         Width="5"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         Background="Transparent"
                         ShowsPreview="False"
                         Cursor="SizeWE"/>

            <!-- Right Panel: 3D Render View -->
            <Border Grid.Column="2" 
                    Background="#1E1E1E"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="5,0,0,0">
                <Grid>
                    <!-- Host for DirectX rendering -->
                    <WindowsFormsHost x:Name="RenderHost"
                                     Background="Transparent">
                        <!-- The Forms control will be set in code-behind -->
                    </WindowsFormsHost>

                    <!-- Overlay Controls -->
                    <StackPanel VerticalAlignment="Top" 
                               HorizontalAlignment="Right"
                               Margin="20">
                        <Border Background="#E01E1E1E"
                               BorderBrush="#3F3F46"
                               BorderThickness="1"
                               CornerRadius="6"
                               Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="CAMERA CONTROLS" 
                                          FontWeight="SemiBold"
                                          FontSize="11"
                                          Foreground="#888888"
                                          Margin="0,0,0,8"/>
                                
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Right Mouse" 
                                              FontSize="11"
                                              Foreground="#999999"/>
                                    <TextBlock Text="Rotate" 
                                              Grid.Column="1"
                                              FontSize="11"
                                              Foreground="#E8E8E8"
                                              Margin="8,0,0,0"/>
                                </Grid>
                                
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Middle Mouse" 
                                              FontSize="11"
                                              Foreground="#999999"/>
                                    <TextBlock Text="Pan" 
                                              Grid.Column="1"
                                              FontSize="11"
                                              Foreground="#E8E8E8"
                                              Margin="8,0,0,0"/>
                                </Grid>
                                
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Alt + Left Mouse" 
                                              FontSize="11"
                                              Foreground="#999999"/>
                                    <TextBlock Text="Orbit" 
                                              Grid.Column="1"
                                              FontSize="11"
                                              Foreground="#E8E8E8"
                                              Margin="8,0,0,0"/>
                                </Grid>
                                
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mouse Wheel" 
                                              FontSize="11"
                                              Foreground="#999999"/>
                                    <TextBlock Text="Zoom" 
                                              Grid.Column="1"
                                              FontSize="11"
                                              Foreground="#E8E8E8"
                                              Margin="8,0,0,0"/>
                                </Grid>
                                
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="WASD" 
                                              FontSize="11"
                                              Foreground="#999999"/>
                                    <TextBlock Text="Move Camera" 
                                              Grid.Column="1"
                                              FontSize="11"
                                              Foreground="#E8E8E8"
                                              Margin="8,0,0,0"/>
                                </Grid>
                                
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Q / E" 
                                              FontSize="11"
                                              Foreground="#999999"/>
                                    <TextBlock Text="Up / Down" 
                                              Grid.Column="1"
                                              FontSize="11"
                                              Foreground="#E8E8E8"
                                              Margin="8,0,0,0"/>
                                </Grid>
                                
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="F" 
                                              FontSize="11"
                                              Foreground="#999999"/>
                                    <TextBlock Text="Focus Model" 
                                              Grid.Column="1"
                                              FontSize="11"
                                              Foreground="#E8E8E8"
                                              Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Error Message Overlay -->
                    <Border x:Name="ErrorOverlay"
                           Background="#AA000000"
                           Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" 
                                   HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ErrorCircle24"
                                         FontSize="48"
                                         Foreground="#FF4444"
                                         Margin="0,0,0,10"/>
                            <TextBlock x:Name="ErrorText"
                                      Text="Failed to load mesh"
                                      FontSize="16"
                                      Foreground="White"
                                      TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="#252525"
                BorderBrush="#3F3F46"
                BorderThickness="0,1,0,0"
                Padding="15,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusText" 
                          Grid.Column="0"
                          Text="Ready"
                          VerticalAlignment="Center"
                          Foreground="#999999"
                          FontSize="12"/>
                
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal">
                    <Border Background="#1E1E1E"
                           BorderBrush="#3F3F46"
                           BorderThickness="1"
                           CornerRadius="3"
                           Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FPS" 
                                      Foreground="#888888"
                                      FontSize="11"
                                      Margin="0,0,6,0"/>
                            <TextBlock x:Name="FPSText" 
                                      Text="0"
                                      Foreground="#4CAF50"
                                      FontSize="11"
                                      FontWeight="SemiBold"
                                      MinWidth="25"
                                      TextAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
