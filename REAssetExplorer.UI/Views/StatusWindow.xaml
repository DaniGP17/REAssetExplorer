<Window x:Class="REAssetExplorer.App.Views.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:REAssetExplorer.App.Views"
        mc:Ignorable="d"
        Background="#272727"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:REAssetExplorer.App.Controls"
        xmlns:enums="clr-namespace:REAssetExplorer.UI.Enums"
        xmlns:helpers1="clr-namespace:REAssetExplorer.UI.Helpers"
        d:DataContext="{d:DesignInstance Type=local:StatusWindow, IsDesignTimeCreatable=False}"
        MinWidth="400"
        Title="Loading..." SizeToContent="WidthAndHeight">
    <Window.Resources>
        <helpers1:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border Margin="-20">
            <controls:WindowControls Margin="10" CanMaximize="False" CanClose="{Binding CanClose, FallbackValue=False}" />
        </Border>

        <ui:TextBlock 
            FontTypography="Subtitle" 
            Text="{Binding Type, FallbackValue=Loading}"
            HorizontalAlignment="Center"
            Foreground="White"
            Grid.Row="0"
        />

        <ui:TextBlock
            FontTypography="Body"
            Text="{Binding Message, FallbackValue='Searching encrypted keys, please wait...'}"
            Foreground="Gray"
            Margin="0 20 0 20"
            HorizontalAlignment="Center"
            TextWrapping="Wrap"
            Grid.Row="2"
        />

        <ProgressBar 
            Grid.Row="2"
            IsIndeterminate="True"
            VerticalAlignment="Bottom"
            Visibility="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:StatusType.Loading}}"
            d:Visibility="Visible"
        />
    </Grid>
</Window>
