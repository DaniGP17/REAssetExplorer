<ui:FluentWindow x:Class="REAssetExplorer.App.Views.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:REAssetExplorer.App.Views"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:REAssetExplorer.App.Controls"
        xmlns:enums="clr-namespace:REAssetExplorer.UI.Enums"
        xmlns:helpers1="clr-namespace:REAssetExplorer.UI.Helpers"
        d:DataContext="{d:DesignInstance Type=local:StatusWindow, IsDesignTimeCreatable=False}"
        Width="450"
        SizeToContent="Height"
        MinHeight="150"
        MaxHeight="250"
        Title="Loading..." 
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        d:Background="#1E1E1E"
        d:Foreground="#FFFFFF"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.Resources>
        <helpers1:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
    </ui:FluentWindow.Resources>
    <Grid Margin="20" d:Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title Bar -->
        <ui:TitleBar x:Name="TitleBar"
                     Grid.Row="0" 
                     Title=""
                     ShowMaximize="False"
                     ShowClose="{Binding CanClose, FallbackValue=False}"
                     Margin="-20,-20,-20,0"/>

        <ui:TextBlock 
            FontTypography="Subtitle" 
            Text="{Binding Type, FallbackValue=Loading}"
            HorizontalAlignment="Center"
            Foreground="White"
            Margin="0,10,0,0"
            Grid.Row="1"
        />

        <ui:TextBlock
            FontTypography="Body"
            Text="{Binding Message, FallbackValue='Searching encrypted keys, please wait...'}"
            Foreground="Gray"
            Margin="0,15,0,15"
            HorizontalAlignment="Center"
            TextWrapping="Wrap"
            Grid.Row="2"
        />

        <ProgressBar 
            Grid.Row="3"
            IsIndeterminate="True"
            Margin="0,0,0,10"
            Visibility="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:StatusType.Loading}}"
            d:Visibility="Visible"
        />
    </Grid>
</ui:FluentWindow>
